model Customer {
  id            String     @id @default(cuid())
  customerCode  String     @unique
  firstName     String
  lastName      String
  companyName   String?
  email         String     @unique
  phone         String
  alternatePhone String?
  address       String
  city          String
  state         String
  country       String
  postalCode    String
  taxNumber     String?
  creditLimit   Float?
  currentBalance Float
  loyaltyPoints Int
  totalPurchases Int
  totalOrders   Int
  status        Status     @default(ACTIVE)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model CustomerAddress {
  id           String     @id @default(cuid())
  customerId   String
  title        AddressTitle
  address      String
  city         String
  state        String
  country      String
  postalCode   String
  isDefault    Boolean     @default(false)
  customer     Customer   @relation(fields: [customerId], references: [id])
}

enum AddressTitle {
  Home
  Office
  Warehouse
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
}